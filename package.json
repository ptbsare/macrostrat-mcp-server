{
	"name": "@blake365/macrostrat-mcp",
	"version": "1.0.0",
	"main": "build/index.js",
	"module": "./src/index.ts",
	"type": "module",
	"bin": {
		"macrostrat-mcp": "./build/index.js",
		"macrostrat": "./build/index.js"
	},
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"build": "npx @smithery/cli build",
		"build:stdio": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\" && node -e \"const fs=require('fs');const content=fs.readFileSync('build/index.js','utf8');if(!content.startsWith('#!')){fs.writeFileSync('build/index.js','#!/usr/bin/env node\\n'+content)}\"",
		"build:http": "npx @smithery/cli build",
		"dev": "npx @smithery/cli dev",
		"dev:stdio": "tsx src/index.ts",
		"start": "node build/index.js",
		"prepublishOnly": "npm run build:stdio"
	},
	"files": [
		"build",
		"src",
		"package.json"
	],
	"keywords": ["macrostrat", "geology", "stratigraphy", "mcp"],
	"author": "Blake Morgan",
	"license": "MIT",
	"description": "Macrostrat MCP Server - Access geological data, rock units, formations, and stratigraphic information worldwide",
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.0.4",
		"@types/node": "^22.10.2",
		"node-fetch": "^3.3.2",
		"typescript": "^5.7.2",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@smithery/cli": "^1.2.20",
		"tsx": "^4.20.5"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
